# 이 파일을 복사해서 .env 로 이름을 바꾸고, = 뒤에 발급받은 키를 붙여넣으세요.
# .env 는 git에 올라가지 않습니다(.gitignore에 등록됨).

# 열린국회정보 Open API 인증키 (open.assembly.go.kr → 마이페이지 → 인증키 발급)
ASSEMBLY_API_KEY=

# 네이버 검색 API (developers.naver.com → Application → 내 애플리케이션)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Anthropic API 키 (platform.claude.com → API Keys)
ANTHROPIC_API_KEY=

# 법제처 국가법령정보 공동활용 OC 값(가입 이메일의 @ 앞부분). 비우면 공개 테스트값(test)을 씀
LAW_OC=
