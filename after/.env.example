# ── 앱 ─────────────────────────────────────────────
# 배포 도메인. 공유 링크와 OG 태그에 쓰인다. Vercel 에서는 비워 두면 VERCEL_PROJECT_PRODUCTION_URL 을 쓴다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 저장소 (Supabase) ───────────────────────────────
# 셋 다 비우면 개발용 로컬 파일 저장소(.local-data/)로 동작한다. 프로덕션에서는 필수.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 강제 선택: supabase | local (비우면 자동)
STORE_DRIVER=

# ── 이미지 생성 (fal.ai) ─────────────────────────────
# 비우면 목(mock) 프로바이더로 동작한다 (입력 이미지를 그대로 돌려줌).
FAL_KEY=
# 강제 선택: fal | mock (비우면 FAL_KEY 유무로 자동)
IMAGE_PROVIDER=
# 모델 교체는 여기서. 입력 스키마가 다른 모델이면 src/lib/providers/fal.ts 의 MODEL_ADAPTERS 참고.
FACE_MODEL_ID=fal-ai/flux-pro/kontext
PHOTO_MODEL_ID=fal-ai/nano-banana-pro/edit
# 선택 튜닝
FACE_GUIDANCE_SCALE=3.5
FACE_SAFETY_TOLERANCE=3
PHOTO_RESOLUTION=1K
# 목 프로바이더의 가짜 처리 시간(ms)
MOCK_DELAY_MS=4000

# ── 크론 ───────────────────────────────────────────
# /api/cron/cleanup 호출 시 Authorization: Bearer <CRON_SECRET>. 긴 랜덤 문자열.
CRON_SECRET=
